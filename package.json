{
  "name": "suivi-de-projet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:data": "tsx src/scripts/checkProjectData.ts",
    "summary:data": "tsx src/scripts/projectSummary.ts",
    "dashboard:data": "tsx src/scripts/dashboard.ts",
    "lots:data": "tsx src/scripts/lotsView.ts",
    "validation:data": "tsx src/scripts/validationView.ts",
    "export:summary": "tsx src/scripts/exportSummaryJson.ts",
    "export:validation": "tsx src/scripts/exportValidationJson.ts",
    "export:dashboard-html": "tsx src/scripts/exportDashboardHtml.ts",
    "export:lots-csv": "tsx src/scripts/exportLotsCsv.ts",
    "export:validation-csv": "tsx src/scripts/exportValidationCsv.ts",
    "export:intervenants-csv": "tsx src/scripts/exportIntervenantsCsv.ts",
    "export:validation-html": "tsx src/scripts/exportValidationHtml.ts",
    "export:actions-csv": "tsx src/scripts/exportActionsCsv.ts",
    "export:documents-csv": "tsx src/scripts/exportDocumentsCsv.ts",
    "export:lots-html": "tsx src/scripts/exportLotsHtml.ts",
    "export:intervenants-html": "tsx src/scripts/exportIntervenantsHtml.ts",
    "export:actions-html": "tsx src/scripts/exportActionsHtml.ts",
    "export:documents-html": "tsx src/scripts/exportDocumentsHtml.ts",
    "export:finances-html": "tsx src/scripts/exportFinancesHtml.ts",
    "export:index-html": "tsx src/scripts/exportIndexHtml.ts",
    "build": "npm run export:index-html && npm run export:dashboard-html && npm run export:lots-html && npm run export:validation-html && npm run export:intervenants-html && npm run export:actions-html && npm run export:documents-html && npm run export:finances-html",
    "build:all": "npm run build && npm run export:lots-csv && npm run export:validation-csv && npm run export:intervenants-csv && npm run export:actions-csv && npm run export:documents-csv && npm run export:summary && npm run export:validation",
    "start": "npm run build && echo \"Ouvrez output/index.html dans votre navigateur\""
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
